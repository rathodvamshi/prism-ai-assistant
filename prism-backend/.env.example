# Production environment variables (example)
ENVIRONMENT=production
PORT=8000
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/prismdb?retryWrites=true&w=majority
JWT_SECRET=replace_with_strong_secret
ENCRYPTION_KEY=replace_with_32_characters_min
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key
REDIS_URL=redis://:<password>@redis-host:6379/0
CELERY_BROKER_URL=redis://:<password>@redis-host:6379/0
SESSION_COOKIE_SECURE=true
CORS_ORIGINS=https://your-frontend.vercel.app
SENDER_EMAIL=verified@example.com
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=